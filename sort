async function getMovie() {

    const res = await fetch(API_LINK);
    movies = await res.json();

    all.textContent = movies.length;

    plan.textContent =
        movies.filter(item => item.status === "Plan to Watch").length;

    watch.textContent =
        movies.filter(item => item.status === "Watching").length;

    done.textContent =
        movies.filter(item => item.status === "Watched").length;

    filterMovies();
}
